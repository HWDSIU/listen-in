# Copy to .env and fill in. .env is gitignored - never commit real keys.
# The LLM step runs only when both LLM_API_KEY and LLM_MODEL are set.

# Anthropic (Claude)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=

# Azure OpenAI / Azure AI Foundry
# LLM_PROVIDER=azure_openai
# LLM_MODEL=<deployment-name>
# LLM_BASE_URL=https://<resource>.openai.azure.com
# LLM_API_VERSION=2024-12-01-preview
# LLM_API_KEY=

# OpenAI API (or any OpenAI-compatible server via LLM_BASE_URL)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-6.1
# LLM_API_KEY=

# Optional: explicit ffmpeg binary
# LISTEN_IN_FFMPEG=/usr/local/bin/ffmpeg

# Opt-in live tests (record real radio)
# RUN_LIVE_RADIO_TESTS=1

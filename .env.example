# Copy to .env and fill in. .env is gitignored - never commit real keys.
# The LLM step runs only when both LLM_API_KEY and LLM_MODEL are set.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=
# LLM_BASE_URL=

# Optional: explicit ffmpeg binary
# LISTEN_IN_FFMPEG=/usr/local/bin/ffmpeg

# Opt-in live tests (record real radio)
# RUN_LIVE_RADIO_TESTS=1
